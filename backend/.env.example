# Generate a strong value, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-value

# Optional. If omitted, the app uses backend/db/database.db for local development.
# DATABASE_URL=postgresql://user:password@host/dbname

# Keep disabled unless you are debugging locally.
FLASK_DEBUG=0
